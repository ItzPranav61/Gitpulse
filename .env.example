# ---------- Required for real GitHub data ----------
# Classic or fine-grained token. Public data only, so NO scopes are needed.
# Without it the app runs in demo mode with generated data.
GITHUB_TOKEN=

# ---------- App ----------
# Public URL of your deployment (used in embed snippets and Stripe redirects).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# REQUIRED in production, at least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Used to hash visitors, sign domain-verification tokens and protect internal routes.
# The server refuses to start in production with the placeholder below.
APP_SECRET=change-me-to-a-long-random-string
# Shown on the Privacy, Terms and Refund pages.
NEXT_PUBLIC_COMPANY_NAME=
NEXT_PUBLIC_SUPPORT_EMAIL=
# Where the JSON store lives. Use a persistent disk/volume in production.
DATA_DIR=./.data

# ---------- Stripe (monetization) ----------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Create two Prices in Stripe: a $3/month recurring one and a one-time one.
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_LIFETIME=
# Lets you click through checkout locally without Stripe. Never enable in production.
ALLOW_DEMO_CHECKOUT=1

# ---------- Email (lost-key recovery) ----------
# Create a free account at resend.com, verify your sending domain, then set both.
# Without them the "Lost your key?" form tells customers to contact support.
RESEND_API_KEY=
EMAIL_FROM=GitPulse <support@yourdomain.com>

# ---------- Custom domains (Pro) ----------
# Comma separated list of hostnames that serve THIS app (marketing site + API).
# Any other host is looked up as a customer's custom domain.
# Leave empty to disable custom domain routing.
APP_HOSTS=
# Customers must also prove ownership with a TXT record (shown in the dashboard) before a domain is served.
# Hostname customers point their CNAME at.
NEXT_PUBLIC_CNAME_TARGET=cname.gitpulse.app
